# Core
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=admin@revive.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
DEMO_TIME_SCALE=0.001

# Gemini (safe fallback: deterministic)
AI_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay Test Mode (safe fallback: simulator)
RAZORPAY_USE_API=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret

# Email (safe fallback: simulated)
MESSAGING_PROVIDER=simulated
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
